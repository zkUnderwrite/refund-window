{
  "name": "refundwin",
  "version": "0.1.0",
  "private": true,
  "description": "CLI, keeper, receipts, express mode and dispute briefs for the refund_escrow Soroban contract",
  "license": "MIT",
  "type": "module",
  "bin": {
    "refundwin": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "NODE_PATH=node_modules esbuild ../web/checkout.ts --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=../web/dist/checkout.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "simulate": "node --disable-warning=ExperimentalWarning src/cli.ts simulate",
    "seed": "node --disable-warning=ExperimentalWarning src/cli.ts seed",
    "fixtures": "node --disable-warning=ExperimentalWarning scripts/make-fixtures.ts",
    "typecheck:web": "tsc -p ../web/tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.1.0"
  },
  "devDependencies": {
    "@creit.tech/stellar-wallets-kit": "2.7.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
