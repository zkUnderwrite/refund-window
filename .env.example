# refundwin reads .env from the working directory or the project root;
# process environment variables win. Every variable the app reads is listed.

# Network used when --network is not given: local-sim (offline model) or testnet
REFUNDWIN_NETWORK=local-sim
# Where .refundwin.json / .refundwin-sim.json live (default: working directory)
# REFUNDWIN_DIR=
# Receipt cache base directory (default: ~/.refundwin); receipts go to <base>/receipts/<order_id>.json
# REFUNDWIN_HOME=

# Stellar RPC (testnet only; SDF hosts testnet RPC, mainnet RPC is third-party)
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Contract id (otherwise taken from .refundwin.json written by `refundwin init`)
# REFUNDWIN_CONTRACT=

# Keys: aliases resolve to REFUNDWIN_SECRET_<ALIAS> if set, else `stellar keys secret <alias>`.
# Never commit secrets. Example:
# REFUNDWIN_SECRET_RW_M1=S...
# Alias used by release/timeout/settle-refund/keeper when --caller is not given
KEEPER_KEY=keeper
KEEPER_INTERVAL=10m

# Express-mode window bounds (pre-flight check; the escrow contract has its own)
MIN_WINDOW=1h
MAX_WINDOW=60d
# Buyer timezone for `pay` output when --tz is not given (fixed offset)
BUYER_TZ=+00:00

# Dispute brief LLM provider: OFF unless both are set. LLM_DISPUTES_ALLOWED=true
# records the PSP's data-protection sign-off (docs/DATA-PROTECTION.md).
LLM_API_KEY=
LLM_DISPUTES_ALLOWED=false
LLM_MODEL=claude-sonnet-5
# Language the model answers in (the heuristic brief is English)
ARBITER_LANG=en
